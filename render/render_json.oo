// # File Format JSON Serializer
//
// Logline: Formats machine-readable JSON payloads for MIME types, encodings, and file metadata.
//
// Setup: Pure string serialization conforming to RFC 8259 JSON format.
//
// Beats:
//   1. Escape strings for strict JSON conformance.
//   2. Serialize file path, MIME type, charset encoding, and description.
//   3. Serialize catalog of supported magic byte signatures and categories.
//   4. Deliver structured payloads for automated linting and AI agent consumption.

import "core/magic_signatures.oo";

fn json_str_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b == 92 {
            out = out + "\\\\";
        } else if b == 34 {
            out = out + "\\\"";
        } else if b == 10 {
            out = out + "\\n";
        } else if b == 13 {
            out = out + "\\r";
        } else if b == 9 {
            out = out + "\\t";
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

pub fn render_file_json(path: String, fmt: FileFormat, size: Int) -> String {
    let mut out: String = "{\n"
        + "  \"path\": \"" + json_str_escape(path) + "\",\n"
        + "  \"mime_type\": \"" + json_str_escape(fmt.mime_type) + "\",\n"
        + "  \"charset\": \"" + json_str_escape(fmt.charset) + "\",\n"
        + "  \"category\": \"" + json_str_escape(fmt.category) + "\",\n"
        + "  \"description\": \"" + json_str_escape(fmt.description) + "\",\n"
        + "  \"size\": " + size.to_string() + "\n"
        + "}\n";
    return out;
}

pub fn render_magic_catalog_json() -> String {
    let mut out: String = "{\n  \"signatures\": [\n"
        + "    {\"format\": \"elf\", \"mime\": \"application/x-executable\", \"offset\": 0, \"magic\": \"\\\\x7fELF\"},\n"
        + "    {\"format\": \"pe\", \"mime\": \"application/x-dosexec\", \"offset\": 0, \"magic\": \"MZ\"},\n"
        + "    {\"format\": \"wasm\", \"mime\": \"application/wasm\", \"offset\": 0, \"magic\": \"\\\\x00asm\"},\n"
        + "    {\"format\": \"pdf\", \"mime\": \"application/pdf\", \"offset\": 0, \"magic\": \"%PDF-\"},\n"
        + "    {\"format\": \"png\", \"mime\": \"image/png\", \"offset\": 0, \"magic\": \"\\\\x89PNG\"},\n"
        + "    {\"format\": \"zip\", \"mime\": \"application/zip\", \"offset\": 0, \"magic\": \"PK\\\\x03\\\\x04\"},\n"
        + "    {\"format\": \"gzip\", \"mime\": \"application/gzip\", \"offset\": 0, \"magic\": \"\\\\x1f\\\\x8b\"}\n"
        + "  ]\n}\n";
    return out;
}
