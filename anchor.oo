// # oofile Root Subsystem Anchor
//
// Logline: Top-level anchor aggregating unit test suites for core, render, and ipc subsystems.
//
// Setup: Pure test harness verifying all internal invariants before release packaging.
//
// Beats:
//   1. Execute core magic byte detection and MIME resolution unit tests.
//   2. Execute render formatting and JSON serialization tests.
//   3. Execute IPC JSON-RPC parsing and CLI dispatching tests.
//   4. Report unified success or failure status.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn run_all_tests() -> Bool {
    if !run_core_tests() {
        print("FAIL: core subsystem tests failed\n");
        return false;
    }
    if !run_render_tests() {
        print("FAIL: render subsystem tests failed\n");
        return false;
    }
    if !run_ipc_tests() {
        print("FAIL: ipc subsystem tests failed\n");
        return false;
    }
    print("ALL oofile internal anchor tests PASSED\n");
    return true;
}
